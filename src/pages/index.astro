---
import ContactForm from '../components/ContactForm.astro';

const pillars = [
  ['01', 'Comprendre', 'Faire le point sur vos habitudes, votre rythme et ce qui vous amène aujourd’hui.'],
  ['02', 'Ajuster', 'Construire des repères concrets, compatibles avec votre quotidien et vos préférences.'],
  ['03', 'Avancer', 'Installer des changements durables, sans perfectionnisme ni liste d’interdits.'],
];

const audiences = [
  'Vous voulez retrouver une relation plus simple avec votre alimentation.',
  'Vous pratiquez une activité sportive et souhaitez mieux soutenir votre énergie.',
  'Vous traversez une période de changement et avez besoin de repères personnalisés.',
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Diététique & Sport — Des repères qui vous ressemblent</title>
    <meta name="description" content="Consultations diététiques personnalisées pour retrouver une alimentation plus sereine et accompagner votre pratique sportive." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&family=Instrument+Serif&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="topbar">
      <a class="brand" href="#top" aria-label="Diététique et Sport, accueil"><span>Diététique</span><b>&</b><span>Sport</span></a>
      <nav aria-label="Navigation principale">
        <a href="#approche">L’approche</a><a href="#accompagnement">Pour qui</a><a href="#contact">Prendre contact</a>
      </nav>
    </header>

    <main id="contenu">
      <section class="hero" id="top">
        <div class="hero-copy reveal">
          <p class="eyebrow">Consultations diététiques personnalisées</p>
          <h1>Retrouver des repères qui vous ressemblent.</h1>
          <p class="hero-lead">Une approche concrète et bienveillante pour avancer dans votre alimentation, soutenir votre énergie et prendre soin de vous dans la vraie vie.</p>
          <a class="button button-dark" href="#contact">Parler de votre situation <span>↗</span></a>
        </div>
        <div class="hero-art" aria-label="Illustration abstraite représentant l'équilibre entre alimentation et mouvement"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="orb orb-three"></div><span class="art-note">manger · bouger · vivre</span></div>
      </section>

      <section class="statement" id="approche">
        <p class="eyebrow">L’approche</p>
        <h2>Pas de méthode toute faite. <em>Un accompagnement construit avec vous.</em></h2>
        <p class="statement-text">Votre alimentation s’inscrit dans une histoire, un emploi du temps, des goûts, une énergie et des contraintes qui vous sont propres. Les consultations partent de là pour transformer les conseils en décisions possibles.</p>
      </section>

      <section class="pillars" aria-label="Les trois étapes de l'accompagnement">
        {pillars.map(([number, title, text]) => <article class="pillar reveal"><span class="number">{number}</span><h3>{title}</h3><p>{text}</p></article>)}
      </section>

      <section class="audience" id="accompagnement">
        <div><p class="eyebrow">Vous pouvez venir pour…</p><h2>Une question précise ou l’envie de changer de rythme.</h2></div>
        <ul>{audiences.map((item) => <li><span>↗</span>{item}</li>)}</ul>
      </section>

      <section class="process">
        <div class="process-card"><p class="eyebrow">La première consultation</p><h2>Un temps pour faire le point, sans jugement.</h2><p>Nous clarifions votre demande, vos habitudes et vos priorités. Vous repartez avec quelques actions simples à tester, et non avec une feuille de route impossible à tenir.</p><a class="text-link" href="#contact">Découvrir le format <span>→</span></a></div>
        <div class="process-side"><div class="stamp">ÉQUILIBRE<br /><span>au quotidien</span></div><p>En cabinet ou à distance<br />Consultations individuelles</p></div>
      </section>

      <section class="contact" id="contact">
        <div><p class="eyebrow">Construisons la suite</p><h2>Parlez-moi de ce que vous cherchez à améliorer.</h2><p>Un premier message suffit pour voir si l’accompagnement peut vous convenir.</p></div>
        <ContactForm id="main-contact" />
      </section>
    </main>

    <footer><span>Diététique & Sport</span><span>Consultations personnalisées</span><span>© {new Date().getFullYear()}</span></footer>

    <style>
      :root { --paper:#f6f3ec; --ink:#20221c; --muted:#6f7066; --line:#d9d5ca; --sage:#bdc9b1; --terracotta:#a75e43; --sans:'DM Sans',sans-serif; --serif:'Instrument Serif',serif; --mono:'DM Mono',monospace; --pad:clamp(1.25rem,5vw,5.5rem); }
      * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font:16px/1.6 var(--sans); } a { color:inherit; text-decoration:none; } .skip { position:absolute; left:-9999px; } .skip:focus { left:1rem; top:1rem; z-index:5; background:var(--ink); color:var(--paper); padding:.5rem 1rem; }
      .topbar { display:flex; justify-content:space-between; align-items:center; padding:1.3rem var(--pad); border-bottom:1px solid var(--line); gap:2rem; } .brand { display:flex; gap:.35rem; align-items:baseline; font:1.35rem var(--serif); } .brand b { color:var(--terracotta); font:1rem var(--sans); } nav { display:flex; gap:clamp(1rem,3vw,2.5rem); color:var(--muted); font:.68rem var(--mono); letter-spacing:.06em; text-transform:uppercase; } nav a:hover { color:var(--terracotta); }
      .hero { min-height:min(780px,calc(100vh - 74px)); display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.9fr); gap:clamp(2rem,8vw,8rem); align-items:center; padding:clamp(4rem,9vw,8rem) var(--pad); border-bottom:1px solid var(--line); } .hero-copy { max-width:40rem; } .eyebrow { margin:0 0 1rem; color:var(--terracotta); font:500 .68rem var(--mono); letter-spacing:.12em; text-transform:uppercase; } h1,h2,h3,p { margin-top:0; } h1,h2 { font-weight:400; line-height:.98; } h1 { max-width:10ch; font:clamp(4rem,8vw,8.7rem)/.88 var(--serif); letter-spacing:-.04em; } h2 { font:clamp(2.6rem,5.2vw,5.2rem)/.95 var(--serif); letter-spacing:-.025em; } h2 em { color:var(--terracotta); font-style:normal; } .hero-lead { max-width:34rem; color:var(--muted); font-size:1.1rem; } .button { display:inline-flex; align-items:center; gap:1.4rem; padding:.95rem 1.3rem; margin-top:1rem; font-size:.85rem; } .button-dark { background:var(--ink); color:var(--paper); } .button-dark:hover { background:var(--terracotta); } .hero-art { position:relative; aspect-ratio:1; max-width:35rem; margin:auto; overflow:hidden; background:var(--sage); border-radius:48% 52% 40% 60% / 55% 42% 58% 45%; } .orb { position:absolute; border-radius:50%; mix-blend-mode:multiply; } .orb-one { width:68%; aspect-ratio:1; background:#e4a67f; top:7%; left:5%; } .orb-two { width:64%; aspect-ratio:1; background:#e6d7a4; right:4%; bottom:5%; } .orb-three { width:42%; aspect-ratio:1; background:#7c9e7f; left:28%; top:27%; } .art-note { position:absolute; right:8%; top:48%; color:var(--ink); font:.65rem var(--mono); letter-spacing:.12em; text-transform:uppercase; transform:rotate(90deg); }
      .statement { max-width:70rem; padding:clamp(5rem,12vw,11rem) var(--pad); } .statement h2 { max-width:16ch; } .statement-text { max-width:35rem; margin-left:auto; color:var(--muted); font-size:1.1rem; } .pillars { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--line); border-bottom:1px solid var(--line); } .pillar { min-height:20rem; padding:2rem var(--pad) 3rem; border-right:1px solid var(--line); } .pillar:last-child { border:0; } .number { color:var(--terracotta); font: .75rem var(--mono); } .pillar h3 { margin-top:4rem; font:2.3rem var(--serif); } .pillar p { max-width:20rem; color:var(--muted); }
      .audience { display:grid; grid-template-columns:1fr 1fr; gap:5rem; padding:clamp(5rem,11vw,10rem) var(--pad); } .audience h2 { max-width:10ch; } ul { list-style:none; padding:0; margin:0; } .audience li { display:flex; gap:1rem; padding:1.2rem 0; border-top:1px solid var(--line); color:var(--muted); } .audience li:last-child { border-bottom:1px solid var(--line); } .audience li span { color:var(--terracotta); }
      .process { display:grid; grid-template-columns:1.4fr .6fr; margin:0 var(--pad); background:#e6dfd1; } .process-card { padding:clamp(2rem,7vw,7rem); } .process-card h2 { max-width:11ch; } .process-card > p:not(.eyebrow) { max-width:34rem; color:var(--muted); } .process-side { display:flex; flex-direction:column; justify-content:space-between; padding:2rem; border-left:1px solid rgba(32,34,28,.15); color:var(--muted); font-size:.8rem; } .stamp { width:9rem; height:9rem; display:grid; place-content:center; border:1px solid var(--terracotta); border-radius:50%; color:var(--terracotta); text-align:center; font:.7rem var(--mono); letter-spacing:.1em; transform:rotate(-12deg); } .stamp span { font:1.4rem var(--serif); letter-spacing:0; } .text-link { display:inline-flex; gap:1.5rem; color:var(--terracotta); font-size:.85rem; } .contact { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:end; padding:clamp(5rem,12vw,11rem) var(--pad) 8rem; } .contact h2 { max-width:10ch; } .contact > div > p:not(.eyebrow) { color:var(--muted); max-width:30rem; } footer { display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap; padding:1.5rem var(--pad); border-top:1px solid var(--line); color:var(--muted); font:.68rem var(--mono); text-transform:uppercase; letter-spacing:.06em; }
      .reveal { opacity:0; transform:translateY(1rem); transition:opacity .7s ease, transform .7s ease; } .reveal.vu { opacity:1; transform:none; } @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } .reveal { opacity:1; transform:none; transition:none; } }
      @media (max-width:760px) { .topbar { align-items:flex-start; } nav { display:none; } .hero,.audience,.contact,.process { grid-template-columns:1fr; } .hero { min-height:auto; padding-top:5rem; } .hero-art { width:80%; margin-top:2rem; } .pillars { grid-template-columns:1fr; } .pillar { min-height:auto; border-right:0; border-bottom:1px solid var(--line); } .pillar h3 { margin-top:2.5rem; } .audience { gap:2rem; } .process { margin:0; } .process-side { min-height:15rem; border-left:0; border-top:1px solid rgba(32,34,28,.15); } .contact { gap:2.5rem; } footer { flex-direction:column; } }
    </style>
    <script>
      const targets = document.querySelectorAll('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) targets.forEach((el) => el.classList.add('vu'));
      else { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('vu'); observer.unobserve(entry.target); } }), { threshold: .12 }); targets.forEach((el) => observer.observe(el)); }
    </script>
  </body>
</html>
